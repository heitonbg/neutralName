# Настройки Express API
PORT=3001
NODE_ENV=development
WEB_APP_URL=http://localhost:5173
BOT_USERNAME=t280_hakaton_max_bot

# Секреты необязательны для локального запуска только API — оставьте поля пустыми.
# Реальные значения храните только в server/.env или в защищённых настройках хостинга.
BOT_TOKEN=
DADATA_TOKEN=
AI_API_KEY=

# Необязательные настройки AI-провайдера. Пример ниже использует OpenRouter.
# AI-функции будут недоступны, пока не заданы AI_API_KEY и AI_MODEL.
AI_MODEL=
AI_API_URL=https://openrouter.ai/api/v1/chat/completions

# Необязательные пути к хранилищу.
# По умолчанию используются server/db/events.sqlite и server/uploads.
# При необходимости укажите для UPLOAD_DIR абсолютный путь.
# DB_PATH=
# UPLOAD_DIR=

# Необязательный адрес Overpass API.
# Если не задан, сервер использует публичные адреса из кода.
# OVERPASS_API_URL=
